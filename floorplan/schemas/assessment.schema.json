{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cozmo provisional internal restoration assessment",
  "type": "object",
  "required": ["schema_version", "published_schema_verified", "property_id", "capture_id", "tier", "status", "rooms", "surfaces", "openings", "measurements", "damage_regions", "concealed_flags", "scope_items", "missing_requirements"],
  "properties": {
    "schema_version": {"enum": ["internal-assessment-v1", "internal-assessment-v2"]},
    "published_schema_verified": {"const": false},
    "property_id": {"type": "string"},
    "capture_id": {"type": "string"},
    "tier": {"type": "string"},
    "status": {"type": "string"},
    "rooms": {"type": "array", "items": {"type": "object", "required": ["id", "corners"]}},
    "surfaces": {"type": "array", "items": {"type": "object", "required": ["id", "room_id", "kind"]}},
    "openings": {"type": "array", "items": {"type": "object", "required": ["id", "surface_id"]}},
    "measurements": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "entity_id", "kind", "value", "unit", "status", "interval"],
        "properties": {
          "value": {"type": ["number", "null"]},
          "unit": {"enum": ["m", "m2"]},
          "status": {"enum": ["estimated", "unavailable"]},
          "interval": {"type": ["object", "null"]}
        }
      }
    },
    "damage_regions": {"type": "array"},
    "concealed_flags": {"type": "array"},
    "scope_items": {"type": "array"},
    "missing_requirements": {"type": "array", "items": {"type": "string"}},
    "property_entity_id": {"type": "string"},
    "connections": {"type": "array", "items": {"type": "object", "required": ["rooms"], "properties": {"rooms": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string"}}}}},
    "contract_complete": {"type": "boolean"}
  },
  "allOf": [{"if": {"properties": {"schema_version": {"const": "internal-assessment-v2"}}}, "then": {"required": ["property_entity_id", "connections"]}}]
}
